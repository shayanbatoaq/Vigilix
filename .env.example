# Public canonical origin. Set to the real production domain before deployment.
NEXT_PUBLIC_SITE_URL=
# Resend API key and verified sender. These remain on the server.
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=
# Shared rate limits for multi-instance/serverless production (Upstash REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Long random secret for hashing rate-limit identities.
RATE_LIMIT_SECRET=
